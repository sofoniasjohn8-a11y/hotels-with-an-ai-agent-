FROM php:8.4

# bcmath and pcntl are not in the base image; everything else Laravel needs
# (pdo_sqlite, sqlite3, mbstring, ctype, dom, tokenizer, openssl, ...) is preinstalled.
RUN apt-get update && apt-get install -y --no-install-recommends git curl unzip \
    && docker-php-ext-install bcmath pcntl \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Node.js (for Vite)
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /var/www/html
